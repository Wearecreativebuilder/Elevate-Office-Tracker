# Add these in Vercel → Project → Settings → Environment Variables.
# Never commit real values or paste secret values into chat.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Generate SESSION_SECRET securely with a local password manager or: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
# Shared code to admit office staff (not displayed on the website)
REGISTRATION_CODE=replace-with-strong-private-registration-code
# First administrator account setup only; set a different secret value.
ADMIN_SETUP_KEY=replace-with-strong-one-time-admin-setup-key
# DATABASE_SSL=disable    # only when using a trusted local Postgres server, never for production
